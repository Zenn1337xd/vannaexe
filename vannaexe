local speedSteps = {16, 25, 35, 50, 75, 100}
CreateButton("Speed Boost: Normal (16)", function(btn)
    local nextIndex = 1
    for i, val in ipairs(speedSteps) do
        if Config.SpeedBoost == val then
            nextIndex = (i % #speedSteps) + 1
            break
        end
    end
    Config.SpeedBoost = speedSteps[nextIndex]
    btn.Text = "Speed Boost: " .. Config.SpeedBoost
    btn.BackgroundColor3 = (Config.SpeedBoost > 16) and Color3.fromRGB(160, 90, 20) or Color3.fromRGB(45, 45, 45)
end)

CreateButton("📍 Calibrate Ranch Base", function()
    if Character and Character:FindFirstChild("HumanoidRootPart") then
        Config.BaseCFrame = Character.HumanoidRootPart.CFrame
        Notify("Calibrated", "Ranch Base position saved!")
    end
end)

CreateButton("Auto Steal Nearest (Wild)", function()
    if not Config.BaseCFrame then
        Notify("Setup Required", "Calibrate your base first!")
        return
    end

    local targetPart = nil
    local nearestDist = math.huge
    local chosenEgg = nil

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and not IsEggInOwnedRanch(obj) then
            for _, kw in ipairs(Config.TargetEggKeywords) do
                if string.find(string.lower(obj.Name), string.lower(kw)) then
                    local p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    if p and RootPart then
                        local d = (RootPart.Position - p.Position).Magnitude
                        if d < nearestDist then
                            nearestDist = d
                            targetPart = p
                            chosenEgg = obj
                        end
                    end
                end
            end
        end
    end

    if targetPart and RootPart then
        Notify("Snatching", chosenEgg.Name .. " (" .. math.floor(nearestDist) .. "m)")
        RootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
        task.wait(0.3)

        for _, p in ipairs(chosenEgg:GetDescendants()) do
            if p:IsA("ProximityPrompt") then
                fireproximityprompt(p, 1)
            end
        end

        task.wait(0.4)
        RootPart.CFrame = Config.BaseCFrame + Vector3.new(0, 2, 0)
        Notify("Delivered", "Egg returned to base nest!")
    else
        Notify("None Found", "No unowned wild eggs found.")
    end
end)

