                                        task.spawn(function()
                                            StealEgg(obj)
                                        end)
                                    end)
                                end

                                -- 2. 3D World ESP Tag
                                local espTag = part:FindFirstChild("VH_ESP")
                                if Settings.ESP then
                                    if not espTag then
                                        espTag = Instance.new("BillboardGui")
                                        espTag.Name = "VH_ESP"
                                        espTag.Adornee = part
                                        espTag.Size = UDim2.new(0, 160, 0, 36)
                                        espTag.StudsOffset = Vector3.new(0, 4.5, 0)
                                        espTag.AlwaysOnTop = true

                                        local txt = Instance.new("TextLabel")
                                        txt.Name = "Label"
                                        txt.Size = UDim2.new(1, 0, 1, 0)
                                        txt.BackgroundTransparency = 1
                                        txt.TextColor3 = Color3.fromRGB(255, 230, 50)
                                        txt.TextStrokeTransparency = 0
                                        txt.Font = Enum.Font.SourceSansBold
                                        txt.TextScaled = true
                                        txt.Parent = espTag
                                        espTag.Parent = part
                                    end
                                    local label = espTag:FindFirstChild("Label")
                                    if label then
                                        label.Text = fullTitle .. "\n" .. weight .. " [" .. dist .. "m]"
                                    end
                                else
                                    if espTag then espTag:Destroy() end
                                end
                            end
                        end
                    else
                        local espTag = obj:FindFirstChild("VH_ESP", true)
                        if espTag then espTag:Destroy() end
                    end
                end
            end

            PanelTitle.Text = "Map Eggs (" .. eggCount .. ")"
            EggScroll.CanvasSize = UDim2.new(0, 0, 0, eggCount * 54)
        end)
        task.wait(1.2)
    end
end)

