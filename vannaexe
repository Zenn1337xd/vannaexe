-- Button Helpers
local function AddToggle(parent, labelText, defaultState, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.96, 0, 0, 32)
    btn.BackgroundColor3 = defaultState and Color3.fromRGB(35, 135, 35) or Color3.fromRGB(40, 40, 40)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 12
    btn.Text = labelText .. ": " .. (defaultState and "ON" or "OFF")
    btn.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 5)
    c.Parent = btn

    local state = defaultState
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = labelText .. ": " .. (state and "ON" or "OFF")
        btn.BackgroundColor3 = state and Color3.fromRGB(35, 135, 35) or Color3.fromRGB(40, 40, 40)
        callback(state, btn)
    end)
    return btn
end

local function AddButton(parent, labelText, callback)
    local btn = Instance.new("TextButton")
