-- Anh Vanna Exe | Map Eggs Hub (Ride A Pet)
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- State Variables
local Config = {
    ESP = false,
    AutoSteal = false,
    BaseCFrame = nil,
    TargetEggs = {"Solaris", "Blackhole", "Cherub", "Volcanic", "Galaxy", "Bloom"},
    TweenSpeed = 300
}

-- Utility: Send Custom Notification
local function Notify(title, text)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = title,
        Text = text,
        Duration = 3
    })
end

-- 1. Calibrate Base Position
local function CalibrateBase()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        Config.BaseCFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
        Notify("Base Calibrated", "Current location set as safe deposit zone!")
    else
        Notify("Error", "Character not found. Respawn and try again.")
    end
end

-- 2. ESP Radar Engine
local activeESP = {}

local function ClearESP()
    for _, item in pairs(activeESP) do
        if item and item.Parent then item:Destroy() end
    end
    table.clear(activeESP)
end

local function CreateESP(targetModel, eggName)
    if targetModel:FindFirstChild("AnhVannaESP") then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "AnhVannaESP"
    highlight.FillColor = Color3.fromRGB(255, 170, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.Parent = targetModel
    table.insert(activeESP, highlight)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "AnhVannaTag"
    billboard.Adornee = targetModel.PrimaryPart or targetModel:FindFirstChildWhichIsA("BasePart")
    billboard.Size = UDim2.new(0, 150, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 4, 0)
    billboard.AlwaysOnTop = true

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 0)
    label.TextStrokeTransparency = 0
    label.TextScaled = true
    label.Text = eggName
    label.Parent = billboard

    billboard.Parent = targetModel
    table.insert(activeESP, billboard)
end

task.spawn(function()
    while task.wait(1) do
        if Config.ESP then
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") then
                    for _, name in pairs(Config.TargetEggs) do
                        if string.find(string.lower(obj.Name), string.lower(name)) then
                            CreateESP(obj, obj.Name)
                        end
                    end
                end
            end
        else
            ClearESP()
        end
    end
end)

-- 3. Movement & Steal Helper
local function SafeMoveTo(targetCFrame)
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = Character.HumanoidRootPart
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    local timeToTravel = math.clamp(dist / Config.TweenSpeed, 0.2, 5)

    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

local function InteractWithEgg(eggModel)
    for _, desc in pairs(eggModel:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            fireproximityprompt(desc, 1)
            return true
        end
    end
    return false
end

-- 4. Auto Steal Engine
task.spawn(function()
    while task.wait(0.5) do
        if Config.AutoSteal then
            if not Config.BaseCFrame then
                Notify("Auto Steal", "Please calibrate your Ranch Base first!")
                Config.AutoSteal = false
                continue
            end

            -- Find closest target egg
            local nearestEgg = nil
            local shortestDist = math.huge

            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) then
                    for _, name in pairs(Config.TargetEggs) do
                        if string.find(string.lower(obj.Name), string.lower(name)) then
                            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            local d = (RootPart.Position - part.Position).Magnitude
                            if d < shortestDist then
                                shortestDist = d
                                nearestEgg = obj
                            end
                        end
                    end
                end
            end

            -- Execute steal route
            if nearestEgg then
                local eggPart = nearestEgg.PrimaryPart or nearestEgg:FindFirstChildWhichIsA("BasePart")
                Notify("Snatching Egg...", nearestEgg.Name .. " (" .. math.floor(shortestDist) .. "m away)")
                
                -- Teleport to egg
                SafeMoveTo(eggPart.CFrame + Vector3.new(0, 3, 0))
                task.wait(0.3)
                InteractWithEgg(nearestEgg)
                task.wait(0.5)

                -- Return to base nest
                SafeMoveTo(Config.BaseCFrame + Vector3.new(0, 2, 0))
                Notify("Auto Steal Success", "Delivered " .. nearestEgg.Name .. " to Base!")
                task.wait(1.5)
            end
        end
    end
end)

