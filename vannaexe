-- Strict check: Must be a WILD egg (not in player ranch, hands, or plot)
local function IsValidWildRareEgg(model)
    if not model or not model:IsA("Model") then return false end

    -- Exclude if attached to any player or character
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and model:IsDescendantOf(player.Character) then
            return false
        end
    end

    local mName = string.lower(model.Name)
    if mName:find("held") or mName:find("display") or mName:find("preview") or mName:find("stone") or mName:find("cracked") or mName:find("leaf") or mName:find("sinister") or mName:find("soul") then
        return false
    end

    -- Exclude owned ranches/plots
    local current = model.Parent
    while current and current ~= Workspace do
        local cName = string.lower(current.Name)
        if cName:find("ranch") or cName:find("plot") or cName:find("base") or cName:find("nest") or cName:find("owned") then
            return false
        end
        current = current.Parent
    end

    -- Match rarity keyword strictly
    for _, kw in ipairs(Settings.TargetRarities) do
        if mName:find(string.lower(kw)) then
            return true
        end
    end

    -- Check attributes for rarity keywords
    for attrName, attrVal in pairs(model:GetAttributes()) do
        if typeof(attrVal) == "string" then
            for _, kw in ipairs(Settings.TargetRarities) do
                if string.lower(attrVal):find(string.lower(kw)) then
                    return true
                end
            end
        end
    end

    return false
end

-- Number Formatter for KG (e.g. 17730 -> 17.73K KG)
local function FormatNumber(num)
    if typeof(num) ~= "number" then num = tonumber(num) end
    if not num then return nil end
    if num >= 1e12 then
        return string.format("%.2fT KG", num / 1e12)
    elseif num >= 1e9 then
        return string.format("%.2fB KG", num / 1e9)
    elseif num >= 1e6 then
        return string.format("%.2fM KG", num / 1e6)
    elseif num >= 1e3 then
        return string.format("%.2fK KG", num / 1e3)
    else
        return string.format("%.2f KG", num)
    end
end

-- Extract KG and Rarity Title
local function GetEggInfo(model)
    local weightStr = nil
    local rarityStr = nil

    -- 1. Check Attributes
    for _, obj in ipairs({model, model.PrimaryPart, model:FindFirstChildWhichIsA("BasePart")}) do
        if obj then
            for attrName, attrVal in pairs(obj:GetAttributes()) do
                local lower = string.lower(attrName)
                if lower:find("weight") or lower:find("kg") or lower:find("size") or lower:find("mass") then
                    if typeof(attrVal) == "number" then
                        weightStr = FormatNumber(attrVal)
                    elseif typeof(attrVal) == "string" then
                        weightStr = attrVal
                    end
                elseif lower:find("rarity") or lower:find("tier") then
                    rarityStr = tostring(attrVal)
                end
            end
        end
    end

    -- 2. Check internal Value objects
    if not weightStr then
        for _, desc in ipairs(model:GetDescendants()) do
            if desc:IsA("ValueBase") then
                local lower = string.lower(desc.Name)
                if lower:find("weight") or lower:find("kg") then
                    weightStr = typeof(desc.Value) == "number" and FormatNumber(desc.Value) or tostring(desc.Value)
                elseif lower:find("rarity") or lower:find("tier") then
                    rarityStr = tostring(desc.Value)
                end
            end
        end
    end

    -- 3. Check TextLabels
    if not weightStr then
        for _, desc in ipairs(model:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Text ~= "" and desc.Name ~= "Label" and not desc:IsDescendantOf(GuiParent) then
                local clean = string.gsub(desc.Text, "<[^>]->", "")
                local found = string.match(clean, "(%d+%.?%d*%s*[KkMmBbTtQq]?%s*[Kk][Gg])")
                if found then
                    weightStr = found
                    break
                end
            end
        end
    end

    -- Fallback rarity detect from model name
    if not rarityStr then
        for _, kw in ipairs(Settings.TargetRarities) do
            if string.lower(model.Name):find(string.lower(kw)) then
                rarityStr = kw
                break
            end
        end
    end

    weightStr = weightStr or "Standard KG"
    rarityStr = rarityStr or "Rare"
    return weightStr, rarityStr
end

-- =======================================================
--             SMOOTH TWEEN FLIGHT & AUTO-STEAL           
-- =======================================================

local isBusyStealing = false

local function SafeFlight(targetCFrame)
    if not Character or not RootPart then return false end
    local dist = (RootPart.Position - targetCFrame.Position).Magnitude
    local duration = math.clamp(dist / Settings.FlySpeed, 0.25, 4.0)

    local wasAnchored = RootPart.Anchored
    RootPart.Anchored = true

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(RootPart, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()

    RootPart.Anchored = wasAnchored
    return true
end

local function StealEgg(eggModel)
    if isBusyStealing then return end
    if not Settings.BaseCFrame then
        SendNotification("Notice", "Calibrate Ranch Nest first!")
        return
    end

    local part = eggModel.PrimaryPart or eggModel:FindFirstChildWhichIsA("BasePart")
    if not part or not RootPart then return end

    isBusyStealing = true

    -- 1. Fly to egg
    SafeFlight(part.CFrame + Vector3.new(0, 3, 0))
    task.wait(0.15)

    -- 2. Instant Pickup
    for _ = 1, 3 do
        for _, prompt in ipairs(eggModel:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                prompt.HoldDuration = 0
                prompt.MaxActivationDistance = 99999
                prompt.RequiresLineOfSight = false
                fireproximityprompt(prompt, 0)
                fireproximityprompt(prompt, 1)
            end
        end
        task.wait(0.1)
    end

    task.wait(0.2)

    -- 3. Fly back to Ranch Nest
    SafeFlight(Settings.BaseCFrame + Vector3.new(0, 2, 0))
    task.wait(1.2) -- Deposit clearance
    SendNotification("Delivered", "Egg delivered to base nest!")

    isBusyStealing = false
end

local function FindBestWildEgg()
    local bestTarget, bestDist = nil, math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if IsValidWildRareEgg(obj) then
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part and RootPart then
                local d = (RootPart.Position - part.Position).Magnitude
                if d <= Settings.MaxDistance and d < bestDist then
                    bestDist = d
                    bestTarget = obj
                end
            end
        end
    end
    return bestTarget
end

