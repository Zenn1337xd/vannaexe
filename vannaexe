-- Filter check for player bases
local function IsInOwnedBase(model)
    local current = model.Parent
    while current and current ~= Workspace do
        local name = string.lower(current.Name)
        if name:find("ranch") or name:find("plot") or name:find("base") or name:find("nest") then
            return true
        end
        current = current.Parent
    end
    return false
end

-- Extract KG weight
local function ReadEggWeight(model)
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Text ~= "" then
            local found = string.match(desc.Text, "%d+%.?%d*%s*[kKmMbBtTqQ]?[gG]?%s*KG")
            if found then return found end
        end
    end
    return "Unknown KG"
end

-- =======================================================
--            SMOOTH FLY & AUTO-STEAL CORE ENGINE         
-- =======================================================

local isBusyStealing = false

local function FlyTo(targetCFrame)
    if not Character or not RootPart then return false end
    local distance = (RootPart.Position - targetCFrame.Position).Magnitude
    local duration = math.clamp(distance / Settings.FlySpeed, 0.25, 4.5)

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(RootPart, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
    return true
end

local function StealEgg(eggModel)
    if isBusyStealing then return end
    if not Settings.BaseCFrame then
        SendNotification("Ranch Missing", "Calibrate Ranch Nest first!")
        return
    end

    local part = eggModel.PrimaryPart or eggModel:FindFirstChildWhichIsA("BasePart")
    if not part or not RootPart then return end

    isBusyStealing = true

    -- 1. Fly smoothly to target egg
    SendNotification("Vanna Hub", "Flying to " .. eggModel.Name .. "...")
    FlyTo(part.CFrame + Vector3.new(0, 3, 0))
    task.wait(0.2)

    -- 2. Trigger pick up
    for _ = 1, 3 do
        for _, prompt in ipairs(eggModel:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                pcall(function()
                    fireproximityprompt(prompt, 0)
                    fireproximityprompt(prompt, 1)
                end)
            end
        end
        task.wait(0.15)
    end

    task.wait(0.3)

    -- 3. Fly back to safe deposit nest
    SendNotification("Vanna Hub", "Delivering to Base Nest...")
    FlyTo(Settings.BaseCFrame + Vector3.new(0, 2.5, 0))

    -- 4. Hold at base for deposit clearance
    task.wait(1.2)
    SendNotification("Delivered", "Collected: " .. eggModel.Name)

    isBusyStealing = false
end

