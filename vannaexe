local function FindBestWildEgg()
    local bestTarget, bestDist = nil, math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (not Settings.FilterRanchEggs or not IsInOwnedBase(obj)) then
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if part and RootPart then
                for _, kw in ipairs(Settings.TargetRarities) do
                    if obj.Name:lower():find(kw:lower()) then
                        local d = (RootPart.Position - part.Position).Magnitude
                        if d < bestDist then
                            bestDist = d
                            bestTarget = obj
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

AddButton(FarmPage, "Instant Snatch Nearest", function()
    local target = FindBestWildEgg()
    if target then
        task.spawn(function() StealEgg(target) end)
    else
        SendNotification("None Found", "No wild rare eggs nearby!")
    end
end)

