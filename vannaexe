local Config = {
    ESP = false,
    AutoSteal = false,
    InfiniteJump = false,
    JumpPowerMult = 1,
    SpeedBoost = 16,
    BaseCFrame = nil,
    TargetEggKeywords = {"Solaris", "Blackhole", "Cherub", "Volcanic", "Galaxy", "Bloom"},
    IgnoredZones = {"Ranch", "Plot", "Base", "Nest", "Owned"}
}

local function Notify(title, text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 2.5
        })
    end)
end

local function IsEggInOwnedRanch(model)
    local current = model.Parent
    while current and current ~= Workspace do
        for _, keyword in ipairs(Config.IgnoredZones) do
            if string.find(string.lower(current.Name), string.lower(keyword)) then
                return true
            end
        end
        current = current.Parent
    end
    return false
end

local function GetEggWeight(model)
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("TextLabel") or child:IsA("SurfaceGui") or child:IsA("BillboardGui") then
            local text = child:IsA("TextLabel") and child.Text or ""
            local match = string.match(text, "%d+%.?%d*%s*[kKmMbBtTqQ]?[gG]?%s*KG")
            if match then return match end
        end
    end
    return nil
end

-- ESP Radar Engine
local ActiveESP = {}

local function ClearESP()
    for _, tag in pairs(ActiveESP) do
        if tag and tag.Parent then tag:Destroy() end
    end
    table.clear(ActiveESP)
end

local function UpdateESP()
    if not Config.ESP then
        ClearESP()
        return
    end

    if not Character or not RootPart then return end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) then
            local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            local isTargetEgg = false

            for _, kw in ipairs(Config.TargetEggKeywords) do
                if string.find(string.lower(obj.Name), string.lower(kw)) then
                    isTargetEgg = true
                    break
                end
            end

            if isTargetEgg and not IsEggInOwnedRanch(obj) then
                local dist = math.floor((RootPart.Position - part.Position).Magnitude)
                local weight = GetEggWeight(obj)

                local billboard = obj:FindFirstChild("AV_ESP_TAG")
                local label

                if not billboard then
                    billboard = Instance.new("BillboardGui")
                    billboard.Name = "AV_ESP_TAG"
                    billboard.Adornee = part
                    billboard.Size = UDim2.new(0, 180, 0, 45)
                    billboard.StudsOffset = Vector3.new(0, 4.5, 0)
                    billboard.AlwaysOnTop = true

                    label = Instance.new("TextLabel")
                    label.Name = "Label"
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.TextColor3 = Color3.fromRGB(255, 220, 40)
                    label.TextStrokeTransparency = 0
                    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    label.Font = Enum.Font.SourceSansBold
                    label.TextScaled = true
                    label.Parent = billboard

                    billboard.Parent = obj
                    table.insert(ActiveESP, billboard)
                else
                    label = billboard:FindFirstChild("Label")
                end

                if label then
                    local displayString = obj.Name .. " [" .. dist .. "m]"
                    if weight then
                        displayString = displayString .. " (" .. weight .. ")"
                    end
                    label.Text = displayString
                end
            elseif IsEggInOwnedRanch(obj) then
                local existing = obj:FindFirstChild("AV_ESP_TAG")
                if existing then existing:Destroy() end
            end
        end
    end
end

task.spawn(function()
    while true do
        pcall(UpdateESP)
        task.wait(1)
    end
end)

